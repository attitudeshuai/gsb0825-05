generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  email     String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  billingCycle String   @default("monthly")
  maxUsers    Int
  maxStorage  Int
  features    Json
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenants     Tenant[]
  fromChanges PlanChangeRecord[] @relation("FromPlan")
  toChanges   PlanChangeRecord[] @relation("ToPlan")
}

model Tenant {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  code          String    @unique
  contactName   String
  contactEmail  String
  contactPhone  String?
  address       String?
  status        String    @default("active")
  suspendReason String?
  storageUsed   Float     @default(0)
  planId        Int
  plan          Plan      @relation(fields: [planId], references: [id])
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bills         Bill[]
  tenantUsers   TenantUser[]
  planChanges   PlanChangeRecord[]
}

model TenantUser {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  amount      Decimal   @db.Decimal(10, 2)
  billDate    DateTime
  dueDate     DateTime
  status      String    @default("pending")
  paidAt      DateTime?
  items       Json
  remark      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlanChangeRecord {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  fromPlanId     Int
  fromPlan       Plan     @relation("FromPlan", fields: [fromPlanId], references: [id])
  toPlanId       Int
  toPlan         Plan     @relation("ToPlan", fields: [toPlanId], references: [id])
  changeType     String
  priceDiff      Decimal  @db.Decimal(10, 2)
  proratedAmount Decimal  @db.Decimal(10, 2) @default(0)
  billId         Int?
  remark         String?
  createdAt      DateTime @default(now())
}
