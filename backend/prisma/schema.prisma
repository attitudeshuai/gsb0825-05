generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  email     String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  billingCycle String   @default("monthly")
  maxUsers    Int
  maxStorage  Int
  features    Json
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenants     Tenant[]
  fromChanges PlanChange[] @relation("FromPlanChanges")
  toChanges   PlanChange[] @relation("ToPlanChanges")
}

model Tenant {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  contactName String
  contactEmail String
  contactPhone String?
  address     String?
  status      String    @default("active")
  planId      Int
  plan        Plan      @relation(fields: [planId], references: [id])
  trialEndsAt DateTime?
  storageUsed Int       @default(0)
  creditBalance Decimal @default(0) @db.Decimal(10, 2)
  suspendedAt DateTime?
  suspendedReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bills       Bill[]
  tenantUsers TenantUser[]
  planChanges PlanChange[]
}

model TenantUser {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  amount      Decimal   @db.Decimal(10, 2)
  billDate    DateTime
  dueDate     DateTime
  status      String    @default("pending")
  paidAt      DateTime?
  items       Json
  remark      String?
  billType    String    @default("subscription")
  relatedChangeId Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlanChange {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  fromPlanId  Int
  toPlanId    Int
  fromPlan    Plan      @relation("FromPlanChanges", fields: [fromPlanId], references: [id])
  toPlan      Plan      @relation("ToPlanChanges", fields: [toPlanId], references: [id])
  changeType  String
  proratedAmount Decimal @db.Decimal(10, 2)
  effectiveDate DateTime
  remark      String?
  createdAt   DateTime  @default(now())
}
